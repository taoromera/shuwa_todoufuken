# MongoDB connection string (Atlas: Database > Connect > Drivers)
MONGODB_URI=
# Database name inside the cluster
MONGODB_DB=shuwa

# Random secret, 32+ characters (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=
# Public URL of the app (no trailing slash). Must match PORT locally.
BETTER_AUTH_URL=http://localhost:3000

# Resend API key and a sender on a domain verified in Resend.
# Locally these can be left empty: reset links are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM=手話単語帳 <noreply@example.com>

# Railway bucket (bucket > Credentials tab). Locally these can be left empty:
# videos are then served from the local videos/ folder.
S3_ENDPOINT=https://t3.storageapi.dev
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# "virtual" (default) or "path" for older buckets
S3_URL_STYLE=virtual

PORT=3000
